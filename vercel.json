  "images": {
    "sizes": [
      128,
      256,
      384,
      640,
      828
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "*.public.blob.vercel-storage.com"
      }
    ]
  },
  "rewrites": [
    {
      "source": "/n/:c([A-Za-z0-9_-]+)",
